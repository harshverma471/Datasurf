# DataSurf — copy to .env and fill in. `.env` is gitignored; this template is not.
#
#   cp .env.example .env
#
# The only required value is the key. Everything else has a default in config.py.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Override the model without touching code. Leave empty for openai/gpt-6-luna.
#   free fallback   nvidia/nemotron-3-super-120b-a12b:free
#   eval comparison deepseek/deepseek-v4-flash
DATASURF_MODEL=
